# =====================================================================
# HybridRAG Environment Configuration Template
# Copy this file to '.env' and fill in the values as appropriate.
# Do NOT commit '.env' containing real secrets to version control.
# =====================================================================

# Optional: Gemini API Key for final answer generation
# If left blank, HybridRAG operates in Retrieval & Rerank mode (pure retrieval + evidence view)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the Gemini generation model (default: gemini-3.8-flash)
# Set this to switch to a different Gemini model without changing source code.
GEMINI_MODEL=gemini-3.8-flash

# Embedding Model for Dense Retrieval (Sentence Transformers)
# Default lightweight, fast model for CPU: all-MiniLM-L6-v2 (384 dimensions)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Cross-Encoder Model for Precision Reranking
# Default: cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2

# Retrieval hyperparameters
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100
DEFAULT_TOP_K_RETRIEVAL=10
DEFAULT_TOP_K_RERANK=5
DEFAULT_RRF_K=60
